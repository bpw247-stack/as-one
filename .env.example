# Copy this file to .env and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API.
# The anon key is safe to ship in the app; the database rules protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
